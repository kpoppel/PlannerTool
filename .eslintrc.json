{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": ["prettier", "eslint:recommended", "plugin:lit/recommended"],
  "plugins": ["lit", "local"],
  "rules": {
    "no-var": "error",
    "prefer-const": "warn",
    "no-unused-vars": ["off", { "argsIgnorePattern": "^_" }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "tests/**/*.mjs", "*.test.js"],
      "env": { "node": true },
      "rules": {
        "no-undef": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "www/js/vendor/", "docs/"]
}
