#!/usr/bin/env python3
"""Explicit offline migrations for operator-owned deployment configuration."""
import argparse

from deploy_auth import migrate_auth_configuration


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    auth = commands.add_parser('auth', help='Migrate auth configuration; stop the stack first')
    auth.add_argument('--config', default='instances.yml')
    auth.add_argument('--output-dir', default='deployment')
    auth.add_argument('--apply', action='store_true', help='Back up and replace changed configuration files')
    args = parser.parse_args()
    changes = migrate_auth_configuration(args.config, args.output_dir, apply=args.apply)
    if not changes:
        print('Authentication configuration is current.')
    for change in changes:
        print(('Applied: ' if args.apply else 'Planned: ') + change)


if __name__ == '__main__':
    main()