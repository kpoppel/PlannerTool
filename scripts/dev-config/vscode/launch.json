{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            // Stop scripts/run_dev.sh's uvicorn first: both use port 8001, which the Vite proxy targets.
            "name": "Planner server (uvicorn :8001)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["planner:make_app", "--factory", "--port", "8001"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.vscode/debug.env",
            "preLaunchTask": "write-debug-env",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
